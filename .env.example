# TEOS Neurona Nexus - variables de entorno
# Copia este archivo como .env y edita con tus valores reales:
#   cp .env.example .env
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore)

# IP de tu Bitaxe en tu red local (192.168.X.X o 10.0.X.X)
BITAXE_IP=192.168.1.100

# Puerto del dashboard web
TEOS_WEB_PORT=8765

# Intervalo del collector en segundos
TEOS_COLLECT_INTERVAL=60

# Intervalo del scheduler en segundos
TEOS_SCHEDULER_INTERVAL=300
