{
  "rules": [
    {
      "id": "emergencia_termica",
      "priority": 1,
      "description": "Si el VRM o ASIC se calientan demasiado, bajar a 600 MHz inmediatamente.",
      "conditions": {
        "vrTemp": { "gte": 78 },
        "temp": { "gte": 68 }
      },
      "action": { "type": "set_frequency", "value": 600 }
    },
    {
      "id": "estabilizacion_error",
      "priority": 1.5,
      "description": "Si el error supera el 1.0%, bajar a 580 MHz para estabilizar el chip.",
      "conditions": {
        "errorPercentage": { "gte": 1.0 }
      },
      "action": { "type": "set_frequency", "value": 580 }
    },
    {
      "id": "optimizacion_frio",
      "priority": 2,
      "description": "Mantener 580 MHz (Punto dulce: maximiza hashrate efectivo y minimiza errores).",
      "conditions": {
        "temp": { "lte": 56 },
        "vrTemp": { "lte": 70 }
      },
      "action": { "type": "set_frequency", "value": 580 }
    },
    {
      "id": "ventilador_estres",
      "priority": 3,
      "description": "Si el ASIC pasa de 60°C, subir el ventilador al 70%.",
      "conditions": {
        "temp": { "gte": 60 }
      },
      "action": { "type": "set_fan", "value": 70 }
    }
  ]
}
