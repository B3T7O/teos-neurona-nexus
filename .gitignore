# Python
__pycache__/
*.pyc
*.pyo

# Backups manuales
*.bak
*.bak_*
*.bak-*
*.backup-*
*.backup_*
*.pre_quarantine*
*.pre-register-guard

# Locks y temporales
*.lock
*.tmp

# Logs (se regeneran)
logs/*.log
*.log

# Datos mutables: NO se versionan los outputs completos
data/raw/*.jsonl
data/processed/*.jsonl
data/processed/*.json
data/processed/*.lock
experiments/*_report.json
experiments/*_manifest.json
experiments/*.jsonl

# PERO sí queremos versionar muestras mínimas (ver nota abajo)
!data/raw/.gitkeep
!data/processed/.gitkeep
backups/

# Backups de datos
data/processed/backup_quarantine_*/
data/processed/*.before_refresh_*

# Logs de servicios (no versionar)
logs/collector.log
logs/scheduler.log
logs/web-server.log

# Reportes del audit engine (se regeneran)
data/audit/

# Guardian runtime data (regenerates every 60s)
data/guardian/
data/healer/
data/evolve/
.env
tools/stratum_proxy/
tproxy-config.toml

# Entornos virtuales
.venv_taproot/
venv/

# Binarios de firmware
*.bin

# Backups
*.bak*

# Runtime logs and packet captures (may contain sensitive mining data)
data/logs/*.log
/tmp/stratum*.pcap
/tmp/stratum*.txt
backup/
.venv-shadow-v2/
data/overclock_watchdog.jsonl
data/critical_backups/
data/processed/*.png
data/processed/*.txt
TEOS_DIAGNOSTICO.txt
